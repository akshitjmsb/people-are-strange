{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/resume-sync",
      "schedule": "0 22 * * *"
    }
  ],
  "functions": {
    "app/api/refresh/route.ts": {
      "maxDuration": 300
    }
  }
}
